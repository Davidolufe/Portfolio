{
  "name": "CarePoint",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-GB",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Workforce",
        "description": "Synthetic CarePoint workforce data: 240 department-month records, Oct 2025–Sep 2026.",
        "lineageTag": "ec0dc3a2-ed3b-4f0d-87ba-c898e5a07662",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "lineageTag": "b29ce5d1-2971-4ccf-b282-d0b2ddc5bf54"
          },
          {
            "name": "Care_Home",
            "dataType": "string",
            "sourceColumn": "Care_Home",
            "summarizeBy": "none",
            "lineageTag": "bb1eb206-4387-4904-9338-5b879a856aff"
          },
          {
            "name": "Department",
            "dataType": "string",
            "sourceColumn": "Department",
            "summarizeBy": "none",
            "lineageTag": "d39a7fdd-3fda-4e29-9967-babb80410e28"
          },
          {
            "name": "Budgeted_Staff_FTE",
            "dataType": "double",
            "sourceColumn": "Budgeted_Staff_FTE",
            "summarizeBy": "sum",
            "lineageTag": "4562c265-6dff-4c32-ad27-c93fb0491245",
            "formatString": "0.0"
          },
          {
            "name": "Actual_Staff_FTE",
            "dataType": "double",
            "sourceColumn": "Actual_Staff_FTE",
            "summarizeBy": "sum",
            "lineageTag": "3363a4d8-d51b-4127-a921-f46201a5e3f1",
            "formatString": "0.0"
          },
          {
            "name": "Vacancies",
            "dataType": "int64",
            "sourceColumn": "Vacancies",
            "summarizeBy": "sum",
            "lineageTag": "11d609d0-9564-492d-ab32-03a4e22c8524",
            "formatString": "#,0"
          },
          {
            "name": "Sickness_Days",
            "dataType": "int64",
            "sourceColumn": "Sickness_Days",
            "summarizeBy": "sum",
            "lineageTag": "045890c3-6a1d-4ad8-8db8-2f6990bbd931",
            "formatString": "#,0"
          },
          {
            "name": "Overtime_Hours",
            "dataType": "int64",
            "sourceColumn": "Overtime_Hours",
            "summarizeBy": "sum",
            "lineageTag": "db596e41-171d-4d84-9d6f-05361fe03f0e",
            "formatString": "#,0"
          },
          {
            "name": "Overtime_Cost_GBP",
            "dataType": "decimal",
            "sourceColumn": "Overtime_Cost_GBP",
            "summarizeBy": "sum",
            "lineageTag": "5a840e63-ecb3-4c19-8153-aadd2886b9e7",
            "formatString": "£#,0.00;−£#,0.00;£0.00"
          },
          {
            "name": "Agency_Hours",
            "dataType": "int64",
            "sourceColumn": "Agency_Hours",
            "summarizeBy": "sum",
            "lineageTag": "82a5d45a-8b29-4282-9556-73c977e07edc",
            "formatString": "#,0"
          },
          {
            "name": "Agency_Cost_GBP",
            "dataType": "decimal",
            "sourceColumn": "Agency_Cost_GBP",
            "summarizeBy": "sum",
            "lineageTag": "0dbc01d5-d633-4c5d-9d40-beca3e6fc7c1",
            "formatString": "£#,0.00;−£#,0.00;£0.00"
          },
          {
            "name": "Total_Extra_Staff_Cost_GBP",
            "dataType": "decimal",
            "sourceColumn": "Total_Extra_Staff_Cost_GBP",
            "summarizeBy": "sum",
            "lineageTag": "aed00943-1fbb-49a5-b88b-c76a26b50c7f",
            "formatString": "£#,0.00;−£#,0.00;£0.00"
          },
          {
            "name": "Available_Beds",
            "dataType": "int64",
            "sourceColumn": "Available_Beds",
            "summarizeBy": "sum",
            "lineageTag": "7359600f-7f30-4eb7-a4c5-09289f70143c",
            "formatString": "#,0"
          },
          {
            "name": "Occupied_Beds",
            "dataType": "int64",
            "sourceColumn": "Occupied_Beds",
            "summarizeBy": "sum",
            "lineageTag": "c55cfdd1-4452-4306-be4f-c94e76c45c77",
            "formatString": "#,0"
          },
          {
            "name": "Complaints",
            "dataType": "int64",
            "sourceColumn": "Complaints",
            "summarizeBy": "sum",
            "lineageTag": "3492ec7a-cdb5-4a72-a48e-c0d0389829ee",
            "formatString": "#,0"
          },
          {
            "name": "HomeMonth",
            "dataType": "string",
            "sourceColumn": "HomeMonth",
            "summarizeBy": "none",
            "description": "One point per care home and month, across all selected departments.",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Extra Staffing Cost",
            "expression": "SUM(Workforce[Total_Extra_Staff_Cost_GBP])",
            "formatString": "£#,0.00;−£#,0.00;£0.00",
            "displayFolder": "CarePoint KPIs",
            "description": "Additional overtime and agency expenditure, excluding ordinary salaries.",
            "lineageTag": "571c5e36-5668-4cd8-ab09-118faa44cafd"
          },
          {
            "name": "Overtime Cost",
            "expression": "SUM(Workforce[Overtime_Cost_GBP])",
            "formatString": "£#,0.00;−£#,0.00;£0.00",
            "displayFolder": "CarePoint KPIs",
            "description": "",
            "lineageTag": "895cf5d9-baf1-474b-9097-2c929149c34d"
          },
          {
            "name": "Agency Cost",
            "expression": "SUM(Workforce[Agency_Cost_GBP])",
            "formatString": "£#,0.00;−£#,0.00;£0.00",
            "displayFolder": "CarePoint KPIs",
            "description": "",
            "lineageTag": "fa486908-4511-4632-8476-d24454e95f66"
          },
          {
            "name": "Agency Share",
            "expression": "DIVIDE([Agency Cost], [Extra Staffing Cost])",
            "formatString": "0.0%",
            "displayFolder": "CarePoint KPIs",
            "description": "",
            "lineageTag": "b3be5c96-80b2-4d50-99b9-f22b759b5b99"
          },
          {
            "name": "Vacancy Count",
            "expression": "SUM(Workforce[Vacancies])",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "Sum of source vacancy snapshot counts in the selected context; not distinct posts over time.",
            "lineageTag": "997bc4d2-280a-4513-8041-e7d4269dffdb"
          },
          {
            "name": "Average Monthly Vacancies",
            "expression": "DIVIDE([Vacancy Count], DISTINCTCOUNT(Workforce[Month]))",
            "formatString": "0.00",
            "displayFolder": "CarePoint KPIs",
            "description": "Average monthly count; not vacancy rate or FTE gap.",
            "lineageTag": "2461ee41-496d-4a14-b607-b21584689ad1"
          },
          {
            "name": "Sickness Days",
            "expression": "SUM(Workforce[Sickness_Days])",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "",
            "lineageTag": "27019082-da4d-49b8-add1-6a3825bda183"
          },
          {
            "name": "Overtime Hours",
            "expression": "SUM(Workforce[Overtime_Hours])",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "",
            "lineageTag": "14a0cc1c-42fc-4741-a79d-bc53cacdf16c"
          },
          {
            "name": "Agency Hours",
            "expression": "SUM(Workforce[Agency_Hours])",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "",
            "lineageTag": "f415e68e-a200-4d63-8bab-6ec4c9b5ac52"
          },
          {
            "name": "Available Bed Months",
            "expression": "SUMX(SUMMARIZE(Workforce, Workforce[Month], Workforce[Care_Home]), CALCULATE(MAX(Workforce[Available_Beds])))",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "Home-level capacity, counted once per home-month.",
            "lineageTag": "5f191226-4348-41fe-8c00-029b52b835e3"
          },
          {
            "name": "Occupied Bed Months",
            "expression": "SUMX(SUMMARIZE(Workforce, Workforce[Month], Workforce[Care_Home]), CALCULATE(MAX(Workforce[Occupied_Beds])))",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "Home-level occupied beds, counted once per home-month.",
            "lineageTag": "809ea3e5-8c21-4c4d-b493-43a214c7eeb8"
          },
          {
            "name": "Occupancy",
            "expression": "DIVIDE([Occupied Bed Months], [Available Bed Months])",
            "formatString": "0.0%",
            "displayFolder": "CarePoint KPIs",
            "description": "Weighted over unique home-month observations. Department selection does not create department-level beds.",
            "lineageTag": "d16f54a0-dbff-471d-806e-94234b1ce139"
          },
          {
            "name": "Net FTE Gap",
            "expression": "SUM(Workforce[Budgeted_Staff_FTE]) - SUM(Workforce[Actual_Staff_FTE])",
            "formatString": "0.0",
            "displayFolder": "CarePoint KPIs",
            "description": "Net snapshot FTE gap, not the source integer vacancy count.",
            "lineageTag": "e00f6d56-0866-44a6-9841-77800b69cf54"
          },
          {
            "name": "Home Month Observations",
            "expression": "COUNTROWS(SUMMARIZE(Workforce, Workforce[Month], Workforce[Care_Home]))",
            "formatString": "#,0",
            "displayFolder": "CarePoint KPIs",
            "description": "Number of points available to the scatter chart.",
            "lineageTag": "26b9d115-dcdd-456f-92e5-9d15bae16f6c"
          },
          {
            "name": "Vacancy Cost Correlation",
            "expression": [
              "VAR Points = ADDCOLUMNS(SUMMARIZE(Workforce, Workforce[Month], Workforce[Care_Home]), \"__x\", CALCULATE([Vacancy Count]), \"__y\", CALCULATE([Extra Staffing Cost]))",
              "VAR N = COUNTROWS(Points)",
              "VAR SX = SUMX(Points, [__x])",
              "VAR SY = SUMX(Points, [__y])",
              "VAR SXY = SUMX(Points, [__x] * [__y])",
              "VAR SXX = SUMX(Points, [__x] * [__x])",
              "VAR SYY = SUMX(Points, [__y] * [__y])",
              "VAR VX = N * SXX - SX * SX",
              "VAR VY = N * SYY - SY * SY",
              "RETURN IF(N < 2 || VX <= 0 || VY <= 0, BLANK(), DIVIDE(N * SXY - SX * SY, SQRT(VX * VY)))"
            ],
            "formatString": "0.000;−0.000;0.000",
            "displayFolder": "CarePoint KPIs",
            "description": "Pearson correlation across selected home-months. Recalculates when filtered; blank when insufficient variation.",
            "lineageTag": "57cfe08e-ace7-4e67-b4e9-3e3e4d8b0cd2"
          }
        ],
        "partitions": [
          {
            "name": "Workforce",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Month\", type text}, {\"Care_Home\", type text}, {\"Department\", type text}, {\"Budgeted_Staff_FTE\", type number}, {\"Actual_Staff_FTE\", type number}, {\"Vacancies\", Int64.Type}, {\"Sickness_Days\", Int64.Type}, {\"Overtime_Hours\", Int64.Type}, {\"Overtime_Cost_GBP\", type number}, {\"Agency_Hours\", Int64.Type}, {\"Agency_Cost_GBP\", type number}, {\"Total_Extra_Staff_Cost_GBP\", type number}, {\"Available_Beds\", Int64.Type}, {\"Occupied_Beds\", Int64.Type}, {\"Complaints\", Int64.Type}}, \"en-GB\"),",
                "    HomeMonth = Table.AddColumn(Typed, \"HomeMonth\", each [Month] & \" | \" & [Care_Home], type text)",
                "in",
                "    HomeMonth"
              ]
            }
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Workforce\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
